{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npx -y pnpm@11.22.0 install --frozen-lockfile",
  "buildCommand": "npx -y pnpm@11.22.0 build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://finish-line.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://finish-line.onrender.com/health"
    },
    {
      "source": "/health/:path*",
      "destination": "https://finish-line.onrender.com/health/:path*"
    },
    {
      "source": "/fixtures/:path*",
      "destination": "https://finish-line.onrender.com/fixtures/:path*"
    },
    {
      "source": "/mcp",
      "destination": "https://finish-line.onrender.com/mcp"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
