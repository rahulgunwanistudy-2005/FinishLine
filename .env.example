PORT=3000
# Optional. Local durable files are used when absent.
DATABASE_URL=
DEPLOYXA_API_KEY=
# Reserved sandbox settings; rollback is disabled by the zero-spend policy.
DEPLOYXA_SANDBOX_KEY=
DEPLOYXA_SANDBOX_PROJECT_ID=
DEPLOYXA_SANDBOX_PROJECT_NAME=
# Public origin for self-races and links
PUBLIC_ORIGIN=http://localhost:3000
# Reserved administrator token. Rollback remains disabled; never expose this in the browser.
SANDBOX_ADMIN_TOKEN=
